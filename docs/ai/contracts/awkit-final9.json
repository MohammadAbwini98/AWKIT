  "constraints": {
    "architecture": [
      "Preserve window.playwrightFlowStudio, existing stores, unknown compatible persisted fields and Hologram tokens.",
      "Enabled controls must have trusted underlying behavior; UI validity must use execution admission logic.",
      "Work directly on main with coherent commits and no stash, reset, worktree, new branch or history rewrite."
    ],
    "security": [
      "Never export or log passwords, secrets, tokens, cookies, authenticated browser state, protected contents or private keys.",
      "Installed Chrome is Super-User-only at the trusted IPC boundary, uses an AWKIT-owned scoped profile, never the daily profile, and never silently falls back.",
      "Do not bypass CAPTCHA, MFA, OTP, passkeys, device approval, bot detection or access controls; protected login continues through manual handoff."
    ],
    "offline": [
      "Bundled Chromium remains the default and production must not download a browser or require global Node, Playwright, Chrome, admin rights, network access, CDN or cloud logging.",
      "Mutable favorites, profiles, logs and reports live under approved runtime-data locations, never resources or app.asar."
    ]
  },
