      "order": 1,
      "required": true,
      "inputBindings": {},
      "retryPolicy": {
        "count": 0,
        "delayMs": 0
      },
      "failurePolicy": "stop",
      "position": {
        "x": 120,
        "y": 180
      }
    },
    {
      "id": "consumer-node",
      "type": "flowRef",
      "flowId": "mock-comprehensive-data-consumer-flow",
      "alias": "mock-comprehensive-data-consumer-flow",
      "order": 2,
      "required": true,
      "inputBindings": {},
      "retryPolicy": {
        "count": 0,
        "delayMs": 0
      },
      "failurePolicy": "stop",
      "position": {
        "x": 440,
        "y": 180
      }
    },
    {
      "id": "io-node",
      "type": "flowRef",
      "flowId": "mock-comprehensive-io-flow",
      "alias": "mock-comprehensive-io-flow",
      "order": 3,
      "required": true,
      "inputBindings": {},
      "retryPolicy": {
        "count": 1,
        "delayMs": 100
      },
      "failurePolicy": "stop",
      "position": {
        "x": 760,
        "y": 180
      }
    },
    {
